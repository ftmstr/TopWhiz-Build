{
  "name": "@topwhiz/web",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "compat:check": "vinext check",
    "build:vinext": "vinext build",
    "start:vinext": "vinext start",
    "check:vinext": "vinext check",
    "test:browser": "playwright test --config=playwright.config.ts",
    "build:workerd": "vite build --config vite.workerd.config.ts",
    "dev:workerd": "vite dev --config vite.workerd.config.ts --host 127.0.0.1 --port 3116 --strictPort",
    "preview:workerd": "vite preview --config vite.workerd.config.ts --host 127.0.0.1 --port 3116 --strictPort"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "typescript": "5.9.3",
    "vinext": "1.4.4",
    "@vitejs/plugin-rsc": "0.5.39",
    "@playwright/test": "1.65.0",
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vite-plugin": "1.67.0",
    "vite": "8.3.6"
  }
}
