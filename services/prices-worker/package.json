{
  "name": "@topwhiz/prices-worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:check": "wrangler deploy --dry-run --outdir dist",
    "test:pg": "tsx --test tests/postgres.integration.test.ts",
    "test:cms": "tsx --test tests/cms.integration.test.ts",
    "cms:dry-run": "wrangler deploy --dry-run --config wrangler.cms.toml --outdir dist-cms",
    "test:cms-e2e": "tsx --test tests/cms-e2e.integration.test.ts",
    "test:security": "tsx --test tests/cms-security.integration.test.ts",
    "test:issuer-revocation": "tsx --test tests/cms-issuer.integration.test.ts",
    "test:service-sessions": "tsx --test tests/cms-service-sessions.integration.test.ts",
    "test:dlq": "tsx --test tests/cms-dlq.integration.test.ts",
    "test:race": "tsx --test tests/tur011-race.integration.test.ts",
    "test:rollback": "tsx --test tests/tur012-rollback.integration.test.ts",
    "test:rollback-race": "tsx --test tests/tur012-revoke-race.integration.test.ts",
    "test:dlq-stress": "tsx --test tests/tur012-dlq.integration.test.ts",
    "test:fences": "tsx --test tests/tur013-fences.integration.test.ts",
    "test:queue-ack": "tsx --test tests/tur013-queue-ack.integration.test.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "wrangler": "4.158.0",
    "pg": "8.16.3",
    "@types/pg": "8.15.5",
    "tsx": "4.20.5"
  }
}
