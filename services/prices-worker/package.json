{
  "name": "@topwhiz/prices-worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:check": "wrangler deploy --dry-run --outdir dist",
    "test:pg": "tsx --test tests/postgres.integration.test.ts",
    "test:cms": "tsx --test tests/cms.integration.test.ts",
    "cms:dry-run": "wrangler deploy --dry-run --config wrangler.cms.toml --outdir dist-cms",
    "test:cms-e2e": "tsx --test tests/cms-e2e.integration.test.ts",
    "test:security": "tsx --test tests/cms-security.integration.test.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "wrangler": "4.131.0",
    "pg": "8.16.3",
    "@types/pg": "8.15.5",
    "tsx": "4.20.5"
  }
}
