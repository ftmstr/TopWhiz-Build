      "names": [
        "TPW_DB",
        "TPW_AGENT_WORKFLOW"
      ]
    },
    {
      "id": "news",
      "label": "TPW1 source metadata",
      "kind": "variable",
      "names": [
        "TPW1_FEED_URL",
        "TPW1_FEED_HOST",
        "TPW1_SOURCE_FORMAT",
        "TPW1_SOURCE_HOST",
        "TPW1_SOURCE_PUBLISHER"
      ]
    },
    {
      "id": "device",
      "label": "TPW3 source metadata",
      "kind": "variable",
      "names": [
        "TPW3_FEED_URL",
        "TPW3_FEED_HOST",
        "TPW3_SOURCE_FORMAT",
        "TPW3_SOURCE_HOST",
        "TPW3_SOURCE_PUBLISHER",
        "TPW3_SOURCE_BRAND"
      ]
    },
    {
      "id": "editor",
      "label": "TPW2 editor",
